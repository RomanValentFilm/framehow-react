# Copy to `.env.local` for local development. `.env.local` is git-ignored.
#
# Where the frontend should reach the backend API.
#   - Local backend (`cd backend && npm run dev`):  http://localhost:8787
#   - Production:                                   https://api.framehow.app
# Falls back to http://localhost:8787 if unset.
VITE_API_BASE_URL=http://localhost:8787
